# Bind address
FOLIO_BIND=0.0.0.0:8989
# SQLite database (directories/file are created on start)
DATABASE_URL=sqlite://data/folio.db
# Comma separated browser origins allowed via CORS ("*" for any). Empty = no CORS headers.
FOLIO_CORS_ORIGINS=http://localhost:5173

# --- Auth (Clerk) ---
# JWKS URL defaults to <CLERK_ISSUER>/.well-known/jwks.json
CLERK_ISSUER=
CLERK_JWKS_URL=
# Optional comma separated allow-list for the `azp` claim
FOLIO_CLERK_AUTHORIZED_PARTIES=
# Local development only: accept `Authorization: Bearer dev:<user-id>`. NEVER enable in production.
FOLIO_AUTH_DEV=false

# --- Object storage (snapshots + assets). Leave FOLIO_S3_BUCKET empty for local files. ---
FOLIO_S3_BUCKET=
FOLIO_S3_ENDPOINT=
FOLIO_S3_REGION=auto
FOLIO_S3_ACCESS_KEY_ID=
FOLIO_S3_SECRET_ACCESS_KEY=
FOLIO_ASSETS_DIR=data/assets

# --- AI ---
# All AI requests go through OpenRouter; models are OpenRouter slugs.
OPENROUTER_API_KEY=
# Presets default to Fast (Haiku 5.5), Smart (Sonnet 5.5) and Deep (Opus 5.5). Override with a JSON array of
# {"id","label","hint","model","vision","inputPrice","outputPrice","cachedInputPrice"} (USD per million tokens).
# FOLIO_AI_PRESETS=
FOLIO_AI_DEFAULT_PRESET=smart
FOLIO_AI_TITLE_MODEL=anthropic/claude-haiku-5.5
# Per user and UTC day, in USD
FOLIO_AI_DAILY_CREDIT_USD=1.00
FOLIO_AI_MAX_STEPS=25
FOLIO_AI_MAX_TURN_TOKENS=2000000

# --- Limits ---
FOLIO_MAX_UPDATE_BYTES=8388608
FOLIO_MAX_ASSET_BYTES=26214400
FOLIO_PUSH_RATE_PER_MIN=600

# --- Logging ---
FOLIO_LOG=info
# FOLIO_LOG_FORMAT=pretty
